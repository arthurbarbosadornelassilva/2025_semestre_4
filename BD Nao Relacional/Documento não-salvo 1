5)
MATCH (al:Album)-[:CONTÉM]->(m:Musica)-[:INTERPRETADA_POR]->(ar:Artista)
WITH al, collect(DISTINCT ar.name) AS artistas
WHERE size(artistas) = 1
RETURN al.name AS Album, artistas[0] AS Artista;


6) WITH date() - duration({months: 2}) AS mesesPassados,
date() AS mesAtual
WITH date({year: mesesPassados.year, month: mesesPassados.month, day: 1}) AS inicio,
     date({year: mesAtual.year, month: mesAtual.month, day: mesAtual.day}) AS fim
MATCH (a: Album)
WHERE a.data_lancamento >= inicio and a.data_lancamento <= fim
RETURN a

7) MATCH (a:Album)-[:CONTÉM]->(m:Musica)
RETURN a.name AS nome_album, SUM(m.duracao) AS tempoTotalAlbum
ORDER BY tempoTotalAlbum DESC


8) MATCH (ar:Artista)-[:LANÇOU]->(m:Musica)<-[:CONTÉM]-(al:Album)
WHERE m.duracao > 300
RETURN ar, m, al
